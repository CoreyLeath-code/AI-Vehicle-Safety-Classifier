{
  "name": "Vehicle Safety Classifier Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vehicle-safety",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -280,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.VEHICLE_SAFETY_API_BASE_URL + '/n8n/classify' }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { tool: 'classify_conditions', input: { weather: $json.weather, visibility: $json.visibility, traffic: $json.traffic, driver_state: $json.driver_state } } }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "call-classifier",
      "name": "Call configured classifier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Return classification result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        280,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Call configured classifier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call configured classifier": {
      "main": [
        [
          {
            "node": "Return classification result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "2"
}
